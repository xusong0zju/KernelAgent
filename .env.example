# KernelAgent environment configuration.
# Copy this file to `.env` and fill in your values. The CLIs load `.env`
# automatically (see `triton_kernel_agent/agent.py`). Anything here can also be
# exported directly as environment variables.

# --- Model selection ---
# Model name registered in `utils/providers/available_models.py`. When unset,
# TritonKernelAgent falls back to `claude-sonnet-4-20250514`.
OPENAI_MODEL=deepseek-v4-pro

# Parallel workers per kernel, and retry budget per worker.
NUM_KERNEL_SEEDS=4
MAX_REFINEMENT_ROUNDS=10
LOG_LEVEL=INFO

# --- Anthropic-compatible gateway (e.g. KingCloud kspmas fronting DeepSeek-V4-Pro) ---
# Use this when routing through an OpenAI/Anthropic-compatible proxy. The
# anthropic Python SDK reads these two env vars itself when ANTHROPIC_API_KEY is
# absent, authenticating with `Authorization: Bearer <token>` (which is what
# such gateways expect). No code change needed beyond registering the model in
# available_models.py.
#
# NOTE on base_url: pass the gateway ROOT (e.g. https://kspmas.ksyun.com), not
# the full `/v1/chat/completions` path. The SDK appends `/v1/messages` itself;
# a trailing `/v1/chat/completions` would concatenate into a doubled path that
# only works if the gateway happens to tolerate it.
ANTHROPIC_AUTH_TOKEN=<your-token-here>
ANTHROPIC_BASE_URL=https://kspmas.ksyun.com

# --- Standard Anthropic (api.anthropic.com) ---
# Preferred when ANTHROPIC_API_KEY is set; takes precedence over the token form.
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (api.openai.com, models like `o4-mini`, `gpt-5`) ---
# OPENAI_API_KEY=sk-...

# --- Relay configuration for self-hosted gateways ---
# LLM_RELAY_URL=http://127.0.0.1:11434
# LLM_RELAY_TIMEOUT_S=120
